{
  "name": "fetchservices",
  "description": "A wrapper service to make http fetch requests.",
  "version": "0.2.4",
  "license": "MIT",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./auth": "./dist/auth/index.js",
    "./controller": "./dist/controller/index.js",
    "./interceptors": "./dist/interceptors/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "homepage": "https://github.com/mlmoravek/fetchservices",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlmoravek/fetchservices.git"
  },
  "files": [
    "src",
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "fetch",
    "ofetch",
    "REST",
    "microservice",
    "ajax",
    "service",
    "request"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "run-s lint:eslint lint:prettier",
    "lint:eslint": "eslint . --fix",
    "lint:prettier": "prettier --write .",
    "test:ts": "npx tsc --build --noEmit",
    "test:lint": "run-s test:eslint test:prettier",
    "test:eslint": "eslint .",
    "test:prettier": "prettier --check .",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "update": "ncu -u"
  },
  "dependencies": {
    "ofetch": "^1.5.1"
  },
  "optionalDependencies": {
    "keycloak-js": "^26.2.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.6",
    "@types/node": "26.6.6",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "65.4.11",
    "globals": "17.14.0",
    "npm-check-updates": "23.1.1",
    "npm-run-all2": "9.0.4",
    "prettier": "3.10.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
